MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 689920757}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 84246a412e120284ebb2f40012066458, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  charName: Kelise
  firstLines:
  - "I\u2019m Kelise. I LOVE HATSUNE MIKU."
  - "MIKU. MIKU. MIKU. MIKU. MIKUUUUU\u2026\u2026MIKUUUUUUUUUU"
  secondLines:
  - "I am making a game about Hatsune Miku! It\u2019s gonna be so awesomesauce."
  thirdLines:
  - MIKU MIKU MIKUUUUU MIKU MIKU MIKUUUUU I LOVE MIKUUUUUUUU.
  - "I\u2019m preparing for the Miku Expo if you couldn\u2019t tell."
  fourthLines:
  - I am trying to convince Leah to give in and become her best gay self.
  - She is resisting heavily.
  fifthLines:
  - '*making music with Umi*'
  - This sounds like shit. This is so good.
  sixthLines:
  - It's 3 AM which means it's peak MIKUUUUUU TIMEEEEE!!!
  - '*gets into Hatsune Miku cosplay*'
  - I'm all ready for the Miku expo!!!!
  - In 4 months......
